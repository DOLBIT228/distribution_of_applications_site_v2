# Обов'язково для VPS-режиму (якщо не використовуєте Streamlit secrets)
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.ua/rest/USER_ID/WEBHOOK_TOKEN

# Опційно: чат-бот
CHATBOT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Обов'язково: ключ підпису сесій, випадковий рядок від 32 символів
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# true, коли сайт працює через HTTPS (cookie сесії лише по HTTPS)
SESSION_COOKIE_SECURE=false
